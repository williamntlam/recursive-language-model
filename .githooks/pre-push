#!/usr/bin/env bash
# Require a changelog update in every set of commits pushed from this repository.

set -euo pipefail

zero_oid='0000000000000000000000000000000000000000'
missing_changelog=0

while read -r local_ref local_oid remote_ref remote_oid; do
    # A deleted remote ref has no outgoing repository change to check.
    if [[ "$local_oid" == "$zero_oid" ]]; then
        continue
    fi

    if [[ "$remote_oid" == "$zero_oid" ]]; then
        changed_files=$(git log --format= --name-only "$local_oid")
    else
        changed_files=$(git diff --name-only "$remote_oid" "$local_oid")
    fi

    if ! grep -Fxq 'CHANGELOG.md' <<<"$changed_files"; then
        printf 'Blocked push for %s: outgoing commits do not update CHANGELOG.md.\n' "$local_ref" >&2
        missing_changelog=1
    fi
done

if [[ "$missing_changelog" -ne 0 ]]; then
    cat >&2 <<'EOF'
Update CHANGELOG.md under Unreleased with a local YYYY-MM-DD HH:MM TZ timestamp,
commit it, and push again. Use --no-verify only for an intentional emergency bypass.
EOF
    exit 1
fi
